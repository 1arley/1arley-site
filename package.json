{
    "name": "1arley-template",
    "version": "1.0.0",
    "private": true,
    "description": "Template Next.js 16 + React 19 + TypeScript + Tailwind para projetos multi-domínio",
    "scripts": {
        "dev": "next dev",
        "prebuild": "node src/scripts/generate-sitemap.js && node src/scripts/generate-robots.js",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "check-code": "eslint .",
        "typecheck": "tsc --noEmit",
        "clean-dev": "node -e \"const fs=require('fs'); const path='.next'; if (fs.existsSync(path)) fs.rmSync(path, { recursive: true, force: true });\" && npm run dev",
        "clean-build": "node -e \"const fs=require('fs'); const path='.next'; if (fs.existsSync(path)) fs.rmSync(path, { recursive: true, force: true });\" && npm run build",
        "clean-install": "node -e \"const fs=require('fs'); const path='node_modules'; if (fs.existsSync(path)) fs.rmSync(path, { recursive: true, force: true });\" && npm ci",
        "test:e2e": "playwright test",
        "test:e2e:mobile": "playwright test --project=mobile",
        "prepare": "husky"
    },
    "dependencies": {
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-label": "^2.1.8",
        "@radix-ui/react-slot": "^1.2.4",
        "axios": "^1.16.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "framer-motion": "^12.38.0",
        "geist": "^1.7.2",
        "lucide-react": "^1.16.0",
        "next": "^16.2.6",
        "next-themes": "^0.4.6",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.0.2",
        "tailwindcss-animate": "^1.0.7",
        "three": "^0.185.1"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3",
        "@playwright/test": "^1.62.1",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@types/three": "^0.185.4",
        "eslint": "^9.39.4",
        "eslint-config-next": "^16.2.6",
        "husky": "^9.1.7",
        "playwright": "^1.62.1",
        "postcss": "^8",
        "tailwindcss": "^3.4.1",
        "typescript": "^5"
    }
}
