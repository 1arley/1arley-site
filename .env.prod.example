# Valores de producao do portfolio (1arley.me).
# Copie para .env.prod na raiz. Esse arquivo nao vai para o git.
#
# NEXT_PUBLIC_SITE_URL e inlined no bundle em BUILD time (metadataBase,
# sitemap.xml, robots.txt) e tambem injetado no build pelo
# .github/workflows/cd.yml. Se mudar o dominio, mude nos dois lugares.
NEXT_PUBLIC_SITE_URL=https://1arley.me

# Raiz da API, terminando em /api — o proxy /api/[...path] concatena /v1/...
# Esta e uma variavel de RUNTIME (o build nao precisa dela).
API_BASE_URL=https://onearley-cms-backend.onrender.com/api
